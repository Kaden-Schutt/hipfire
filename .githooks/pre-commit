#!/usr/bin/env bash
# pre-commit hook: fast-track gates every commit + heavy gates only when
# the relevant feature is touched.
#
# Install with:
#   git config core.hooksPath .githooks
#
# Always (when the staged diff touches kernel/forward-pass/dispatch code):
#
#   1) Coherence battery (~2-4 min): fixed prompt matrix through the daemon.
#      Fails only on HARD errors (panic / zero tokens / timeout). Soft
#      output changes don't block — the committer reads the report and
#      confirms coherence before the commit lands. Replaces the old
#      byte-exact quality-gate that blocked legitimate norm-convention fixes.
#
#   2) Speed gate (~30s): prefill/decode tok/s must stay within tolerance
#      of the committed ground-floor baselines. Failure = perf regression.
#
# Path-gated heavy gates (only fire when the matching feature is touched):
#
#   3) DFlash + DDTree coherence (~3 min): spec-decode attractor guard.
#      Fires on `dflash|ddtree|spec_step|...` filename / path matches.
#      Skips otherwise — spec decode rarely breaks from non-spec changes.
#
#   4) PFlash regression (~5 min): long-context bench against the
#      committed gfx1100 baseline. Fires on any path containing `pflash`.
#      Skips otherwise — implemented by setting HIPFIRE_SKIP_PFLASH_GATE=1
#      so the pflash regression stage at the tail of coherence-gate.sh
#      no-ops.
#
# Force-run heavy gates regardless of paths:
#   HIPFIRE_FORCE_PFLASH_GATE=1 git commit ...   # run pflash anyway
#   HIPFIRE_FORCE_SPEC_GATE=1   git commit ...   # run dflash anyway
#
# Do NOT bypass with --no-verify unless you have a plan to fix in the same
# commit.

set -e

# List files staged for this commit.
#
# `R` (renames) is included alongside ACM so that *moving* a hotspot file trips
# the gate: a `git mv crates/hipfire-daemon/src/generate_arch.rs ...` is recorded
# as a rename, and `--name-only` reports its destination path — which still has
# to match the HOTSPOT patterns below. Without `R`, relocating a forward-pass
# file across crates (e.g. the hipfire-serving-core extraction) silently skips
# the coherence battery.
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)

# Docs and markdown can never affect forward-pass output or speed, but a path
# like `docs/roughquant/...` matches the `quant` hotspot substring and would
# otherwise trigger the full GPU gate battery on a docs-only commit. Strip
# docs/markdown for the HEAVY-GATE hotspot decisions below (lint still runs on
# the full staged set via STAGED_RS).
#
# `benchmarks/` is stripped for the same reason: bench harnesses, scratch
# `.hip` files, and captured result JSON are NOT part of the shipped engine
# build (each bench compiles standalone via its own build.sh), so they cannot
# change forward-pass output or speed. Without this, a standalone bench `.hip`
# (e.g. benchmarks/npu_gpu_dmabuf/*.hip) matches the `\.hip$` hotspot and
# false-triggers the ~2-4 min coherence battery on a bench-only commit.
CODE_CHANGED=$(echo "$CHANGED" | grep -vE '(^|/)docs/|(^|/)benchmarks/|\.md$' || true)

# ── Fast-track lint gates (every commit that stages Rust) ────────────────
# rustfmt + clippy run BEFORE the path-gated heavy GPU gates and regardless of
# the HOTSPOT early-exit below, so style/lint never silently slips to CI.
#   - rustfmt blocks only on STAGED files (pre-existing unformatted files
#     elsewhere in the tree don't block this commit).
#   - clippy runs on the changed crates only (full-workspace clippy is CI's
#     job) and blocks on errors; warnings surface but don't block (clippy's
#     default exit), matching CI's advisory stance.
STAGED_RS=$(echo "$CHANGED" | grep -E '\.rs$' || true)
if [ -n "$STAGED_RS" ]; then
    echo "=== Lint: rustfmt (staged) + clippy (changed crates) ==="
    FMT_OUT=$(cargo fmt --all --check 2>&1 || true)
    BLOCK_FMT=0
    for f in $STAGED_RS; do
        # Match only rustfmt's "Diff in <path>:" header lines, not arbitrary
        # substrings. Some files (e.g. env_docs.rs) embed absolute source
        # paths like `source: ".../qwen35.rs:123"` in their content; a bare
        # `grep -F "$f"` matched those and false-positive-blocked an
        # already-formatted staged file whenever an unrelated file was drifted.
        if echo "$FMT_OUT" | grep -F "Diff in " | grep -qF "$f"; then
            echo "  rustfmt: needs formatting -> $f"
            BLOCK_FMT=1
        fi
    done
    if [ "$BLOCK_FMT" = 1 ]; then
        echo
        echo "COMMIT BLOCKED: staged Rust is unformatted. Fix: cargo fmt"
        exit 1
    fi
    echo "  rustfmt: staged files OK"

    PKGS=$(echo "$STAGED_RS" | sed -nE 's|^crates/([^/]+)/.*|\1|p' | sort -u)
    CLIPPY_PKGS=""
    # Only clippy crates that are actual members of this workspace. Crates
    # excluded from the workspace (e.g. the wasm-only hipfire-admin-ui, built
    # standalone via trunk) aren't resolvable with `-p` here and would abort
    # the hook; skip them.
    for p in $PKGS; do
        if cargo pkgid -p "$p" >/dev/null 2>&1; then
            CLIPPY_PKGS="$CLIPPY_PKGS -p $p"
        fi
    done
    if [ -n "$CLIPPY_PKGS" ]; then
        echo "  clippy:$CLIPPY_PKGS --all-targets"
        if ! CLIPPY_OUT=$(cargo clippy $CLIPPY_PKGS --all-targets --locked 2>&1); then
            echo "$CLIPPY_OUT" | grep -E '^(error|warning)' | head -30
            echo
            echo "COMMIT BLOCKED: clippy. Fix, or run: cargo clippy$CLIPPY_PKGS --all-targets"
            exit 1
        fi
        echo "  clippy: OK"
    fi

    # Env-var docs: regenerate from the full tracked source tree and re-stage,
    # so committed docs/env-vars.md + env_docs.rs never drift from the env vars
    # actually read in code. `gen-env-docs` scans the whole tree (not just staged
    # files), so it also absorbs drift left by earlier commits. The freshness
    # CHECK in no-gpu-ci.sh (`gen-env-docs --check`) is the CI-side guard; this
    # is the commit-time fix. `git add` of an unchanged file is a no-op, so this
    # never spuriously pulls the docs into an unrelated commit. A build failure
    # warns but does not block (CI's --check still catches staleness).
    echo "=== Env-var docs: regenerate + re-stage ==="
    if cargo run -q -p hipfire-cli -- gen-env-docs 2>/dev/null; then
        git add docs/env-vars.md crates/hipfire-runtime/src/env_docs.rs
        echo "  env-docs: regenerated + staged (no-op if unchanged)"
    else
        echo "  env-docs: WARN gen-env-docs failed to run; skipping (CI --check still guards)"
    fi
    echo
fi

# Hotspots that can affect forward-pass output or speed.
#
# Updated for post-0.1.20 modular topology (PR 7+):
# - File-name patterns (e.g. `qwen35\.rs`) match across the new arch
#   crate locations (e.g. `crates/hipfire-arch-qwen35/src/qwen35.rs`).
# - `arch\.rs` matches the Architecture trait + per-arch impls
#   (`crates/hipfire-runtime/src/arch.rs`, `crates/hipfire-arch-*/src/arch.rs`).
# - The 4 PR1-4 modules (loop_guard, sampler, prompt_frame, eos_filter)
#   are all hot-path; touching any of them affects every model load.
# - `gemma4\.rs` covered for when the gemma branch forward-ports.
# multi_gpu\.rs is listed here so that touching the PP dispatch path
# triggers the coherence battery (same contract as single-GPU forward).
HOTSPOT='\.hip$|gemv|forward|quant|rotate|dispatch|fwht|rmsnorm|fused|mq4|hfq|magnum|gemm|wmma|llama\.rs|qwen35\.rs|qwen35_vl\.rs|deepseek4\.rs|spec_decode\.rs|gemma4\.rs|sampler\.rs|loop_guard\.rs|prompt_frame\.rs|eos_filter\.rs|arch\.rs|multi_gpu\.rs|mtp_head\.rs|mtp_spec\.rs|mtp_compose\.rs|mtp_probe\.rs'

# Multi-GPU PP hotspots — superset of the HOTSPOT entry above. pp-gate.sh
# runs only when one of these is touched AND 2+ GPUs are visible; otherwise
# it skips (CI / single-GPU dev box).
PP_HOTSPOT='multi_gpu\.rs|peer_access|pp_|pipeline|stages|forward_prefill_batch_multi|forward_scratch_multi|Gpus|init_uniform|init_layers|boundary_copy'

PP_TOUCHED=0
if echo "$CODE_CHANGED" | grep -qE "$PP_HOTSPOT"; then
    PP_TOUCHED=1
fi

if ! echo "$CODE_CHANGED" | grep -qE "$HOTSPOT"; then
    exit 0
fi

# Path-gate the PFlash regression stage that lives at the tail of
# coherence-gate.sh. Skip by default and only run when a `pflash` path
# is staged (or HIPFIRE_FORCE_PFLASH_GATE=1 is set). Saves ~5 min/commit
# when the diff doesn't touch PFlash. Match is intentionally loose
# (`pflash` substring) so it covers the kernel, the arch impl, the bench
# example, and the gate scripts themselves.
PFLASH_HOTSPOT='pflash'
if [ "${HIPFIRE_FORCE_PFLASH_GATE:-0}" = "1" ] \
   || echo "$CODE_CHANGED" | grep -qE "$PFLASH_HOTSPOT"; then
    PFLASH_GATE_ENV=""
    PFLASH_GATE_NOTE="(diff touches pflash — running)"
else
    PFLASH_GATE_ENV="HIPFIRE_SKIP_PFLASH_GATE=1"
    PFLASH_GATE_NOTE="(skipped — no pflash path in diff; force with HIPFIRE_FORCE_PFLASH_GATE=1)"
fi

# ── bind_thread invariant on dispatch.rs ────────────────────────────────
# Multi-GPU plan (issue #58) requires every pub fn in `impl Gpu` to either
# call `self.bind_thread()` first, or carry a `// bind_thread: skip` marker.
# Silent mis-bind = malloc-on-wrong-device → cross-device pointer corruption.
if echo "$CHANGED" | grep -qE 'crates/rdna-compute/src/dispatch\.rs'; then
    if ! ./scripts/verify-bind-thread.sh; then
        echo
        echo "========================================================================"
        echo "COMMIT BLOCKED: dispatch.rs has pub fn missing bind_thread()."
        echo "========================================================================"
        echo
        echo 'Add `self.bind_thread()?;` (or `self.bind_thread_or_warn();` for'
        echo 'non-HipResult fn) as the first statement, OR add a'
        echo '`// bind_thread: skip — <reason>` comment for pure-state queries.'
        echo
        exit 1
    fi
    echo
fi

# ── Tiny affected-model tripwire (git-diff selected front tier) ──────────
# Use git's staged path list as the dependency/touched-file database. The
# selector maps changed paths to the smallest covered tiny_quant family set
# and runs only those cells:
#   exit 0 (selected tiny cells pass, or no tiny-relevant paths) → SKIP the
#           heavy battery for covered forward/quant paths.
#   exit 1 (KLD drift / crash / non-finite) → run the battery.
#   exit 3 (no tiny coverage for touched family, or missing baselines) /
#   exit 2 (couldn't run) → INCONCLUSIVE → run the battery.
# Overrides: HIPFIRE_FORCE_COHERENCE=1 always runs the battery;
#            HIPFIRE_SKIP_TINY_AFFECTED=1 disables the tripwire (battery runs).
# Note: this gates ONLY the coherence battery, not DFlash/spec-decode below.
RUN_COHERENCE=1
if [ "${HIPFIRE_FORCE_COHERENCE:-0}" = "1" ] || [ "${HIPFIRE_SKIP_TINY_AFFECTED:-0}" = "1" ]; then
    : # tripwire disabled — battery runs unconditionally
else
    echo "=== Tiny affected-model tripwire ==="
    # `|| tg=$?` keeps the non-zero exits (1/2/3) from aborting under `set -e`
    # while still capturing the specific code.
    tg=0
    ./tests/tiny-affected-gate.sh --require-coverage || tg=$?
    case "$tg" in
        0) echo "tiny affected: selected coverage passed → SKIPPING heavy coherence battery."
           RUN_COHERENCE=0 ;;
        1) echo "tiny affected: FAIL → escalating to the full coherence battery." ;;
        3) echo "tiny affected: inconclusive/no coverage → running full battery." ;;
        *) echo "tiny affected: could not run → running full battery." ;;
    esac
    echo
fi

# ── Coherence battery ────────────────────────────────────────────────────
if [ "$RUN_COHERENCE" = 1 ]; then
echo "=== Coherence Battery (short) ==="
echo "Engine code changed. Running coherence battery (~2-4 min)..."
echo "PFlash regression stage: $PFLASH_GATE_NOTE"
echo

if ! env $PFLASH_GATE_ENV ./tests/coherence-gate.sh; then
    echo
    echo "========================================================================"
    echo "COMMIT BLOCKED: coherence battery hit a HARD error."
    echo "========================================================================"
    echo
    echo "One or more tests failed with a daemon panic, zero tokens emitted,"
    echo "or timeout. See the report path printed above."
    echo
    echo "Investigation:"
    echo "  ./tests/coherence-gate.sh           # re-run short battery"
    echo "  ./tests/coherence-gate.sh --full    # include A3B tests"
    echo
    echo "Fix the panic/error in the same commit. Do NOT bypass with --no-verify"
    echo "unless you have a plan."
    exit 1
fi

echo
echo "NOTE: the coherence battery does not fail on output changes — only on"
echo "hard errors. Read the report above and confirm each model's output is"
echo "coherent (fluent, on-topic, not stuck in a verbatim loop) before"
echo "proceeding with the commit."
echo
fi  # RUN_COHERENCE

echo

# ── DFlash + DDTree coherence battery ────────────────────────────────────
# Sibling to coherence-gate.sh — exercises spec_step_dflash and
# spec_step_ddtree_batched on 27B with prose + code prompts. Hard-fails
# on Path-A-class single-token attractors (unique_ratio < 0.15 or
# max_freq > 0.50 in first 128 tokens pre-EOT). Skips silently if 27B
# target/draft aren't installed.
SPEC_HOTSPOT='dflash|ddtree|spec_step|tree_verify|gdn_tape|kv_compact_gather|rope_partial|kv_cache_write|spec_decode\.rs|deepseek4'
# File-name alternation tracks the spec-decode pieces of the runtime
# AND the qwen35 arch crate (post-PR-8, speculative.rs moved into
# crates/hipfire-arch-qwen35/src/). dflash.rs + ddtree.rs stay in
# crates/hipfire-runtime/src/. File-name matches catch both.
# pflash.rs is intentionally NOT here — PFlash is a different feature
# (long-context bench), gated separately via PFLASH_HOTSPOT above.
if [ "${HIPFIRE_FORCE_SPEC_GATE:-0}" = "1" ] \
   || echo "$CODE_CHANGED" | grep -qE "$SPEC_HOTSPOT" \
   || echo "$CODE_CHANGED" | grep -qE 'speculative\.rs|qwen35\.rs|ddtree\.rs|dflash\.rs|dflash_spec_demo\.rs|spec_decode\.rs|deepseek4'; then
    # --fast on every commit; --full only when explicitly forced. The fast
    # battery (1 prose + 1 code, dflash only) catches the Path A single-token
    # attractor regression class which is what this gate is here for. The
    # ddtree variants in the short battery add ~2 min of redundant cover for
    # the same failure mode.
    if [ "${HIPFIRE_FORCE_SPEC_GATE:-0}" = "1" ]; then
        DFLASH_FLAG=""
        DFLASH_NOTE="(forced full battery)"
    else
        DFLASH_FLAG="--fast"
        DFLASH_NOTE="(fast: 2 cells, ~1 min — full battery via HIPFIRE_FORCE_SPEC_GATE=1)"
    fi
    echo "=== DFlash/DDTree Coherence Battery $DFLASH_NOTE ==="
    echo "Spec-decode path changed. Running dflash coherence battery..."
    echo
    if ! ./tests/coherence-gate-dflash.sh $DFLASH_FLAG; then
        echo
        echo "========================================================================"
        echo "COMMIT BLOCKED: dflash coherence battery hit a HARD error."
        echo "========================================================================"
        echo
        echo "Either a panic / zero tokens, OR a token attractor was detected"
        echo "in the first 128 tokens pre-EOT (single token > 50% of generation,"
        echo "or unique-token-ratio < 0.15). This is the Path A failure class —"
        echo "see commit 6c84b13 + docs/plans/ddtree-path-b-decouple-rope-from-kvslot.prd."
        echo
        echo "DO NOT bypass with --no-verify. Token-attractor bugs masquerade as"
        echo "+τ / +tok-s wins on stat gates and silently corrupt outputs."
        echo
        echo "Investigation:"
        echo "  ./tests/coherence-gate-dflash.sh           # re-run short (4 cells)"
        echo "  ./tests/coherence-gate-dflash.sh --full    # add b22-k4 + b8-k2"
        echo
        exit 1
    fi
    echo
    echo "NOTE: soft warnings (paragraph-level repetition) do not block but"
    echo "indicate quality drift. Read the report and confirm before commit."
    echo

    # DeepSeek V4 MTP spec-decode sibling gate. Same Path-A attractor guard but
    # via the daemon's HIPFIRE_DEEPSEEK4_SPEC_DECODE=1 path instead of the
    # qwen35 dflash_spec_demo binary. Skips cleanly when the DeepSeek V4 base
    # model isn't symlinked into MODELS_DIR.
    if [ -f "$HOME/.hipfire/models/deepseek-v4-flash.mq2lloyd" ]; then
        echo "=== DeepSeek V4 MTP spec-decode Coherence Battery (fast) ==="
        if ! ./tests/coherence-gate-deepseek4-mtp.sh --fast; then
            echo
            echo "========================================================================"
            echo "COMMIT BLOCKED: DeepSeek V4 MTP coherence battery hit a HARD error."
            echo "========================================================================"
            echo
            exit 1
        fi
        echo
    fi
fi

echo

# ── Agentic gate (--fast) ────────────────────────────────────────────────
# Tool-call shape regression battery for A3B variants under realistic-length
# agent system prompts (Pi-style ~1300 tok, Hermes-style ~780 tok). Guards
# against issue #87-class regressions: prompt-length-sensitive corruption of
# tool_call JSON (special-token leak, malformed JSON, stacked openers) that
# coherence-gate.sh's 50-token system prompt cannot reproduce.
#
# Fires on any HOTSPOT match (same surface as coherence-gate). Skips silently
# if A3B models absent (CI-safe). Force full battery via
# HIPFIRE_FORCE_AGENTIC_GATE=1; skip entirely via HIPFIRE_SKIP_AGENTIC_GATE=1.
if [ "${HIPFIRE_SKIP_AGENTIC_GATE:-0}" != "1" ]; then
    if [ "${HIPFIRE_FORCE_AGENTIC_GATE:-0}" = "1" ]; then
        AGENTIC_FLAG=""
        AGENTIC_NOTE="(forced full: 8 cells, ~5 min)"
    else
        AGENTIC_FLAG="--fast"
        AGENTIC_NOTE="(fast: 1 cell, ~2 min — full via HIPFIRE_FORCE_AGENTIC_GATE=1)"
    fi
    echo "=== Agentic Gate $AGENTIC_NOTE ==="
    echo "Tool-call shape regression cover. Skips if A3B models absent."
    echo
    if ! ./tests/agentic-gate.sh $AGENTIC_FLAG; then
        echo
        echo "========================================================================"
        echo "COMMIT BLOCKED: agentic-gate.sh hit a HARD failure."
        echo "========================================================================"
        echo
        echo "One or more A3B + agent-prompt cells produced corrupt tool_call output:"
        echo "malformed JSON, missing required fields, special-token leak, stacked"
        echo "openers, or > 1 soft-warn (collective threshold)."
        echo
        echo "DO NOT bypass with --no-verify. This regression class silently breaks"
        echo "tool-call parsers downstream — see issue #87 (April 2026 auto-MMQ"
        echo "regression that ChatML-leaked into <tool_call> JSON)."
        echo
        echo "Investigation:"
        echo "  ./tests/agentic-gate.sh --fast        # re-run single cell"
        echo "  ./tests/agentic-gate.sh               # full 8-cell battery"
        echo "  ./tests/agentic-gate.sh --self-check  # verify detectors not rotted"
        echo
        echo "Per-commit escape (use with care): HIPFIRE_SKIP_AGENTIC_GATE=1"
        echo
        exit 1
    fi
    echo
fi

# ── Multi-GPU PP gate ────────────────────────────────────────────────────
# Skips silently when fewer than 2 GPU are visible — single-GPU CI and
# dev boxes don't block on multi-GPU regressions. When 2+ GPU AND a
# multi_gpu/pp_/peer_access hotspot is touched, run the parity battery.
if [ "$PP_TOUCHED" -eq 1 ]; then
    echo "=== Multi-GPU PP Gate ==="
    echo "Multi-GPU code changed. Running pp-gate (skips if <2 GPU)..."
    echo
    if ! ./tests/pp-gate.sh; then
        echo
        echo "========================================================================"
        echo "COMMIT BLOCKED: pp-gate.sh hit a HARD failure."
        echo "========================================================================"
        echo
        echo "Multi-GPU pp=2 ≢ pp=1 byte-identical, refusal contract broken,"
        echo "or daemon panic. Investigation:"
        echo "  ./tests/pp-gate.sh                       # full battery"
        echo "  ./tests/pp-gate.sh --skip-end-to-end     # parity-only"
        echo
        echo "Refer to docs/multi-gpu.md for the validation contract."
        exit 1
    fi
    echo
fi

# ── Speed gate ────────────────────────────────────────────────────────────
echo "=== MQ4 Speed Gate (fast) ==="
echo "Running 4B prefill/decode regression check..."
echo

if ! ./tests/speed-gate.sh --fast; then
    echo
    echo "========================================================================"
    echo "COMMIT BLOCKED: MQ4 speed regression detected."
    echo "========================================================================"
    echo
    echo "Prefill or decode tok/s dropped below the committed ground-floor baseline."
    echo "The current MQ4 numbers are the PERMANENT MINIMUM — no code may ship below."
    echo
    echo "Next steps:"
    echo "  ./tests/speed-gate.sh                 # all sizes (0.8b / 4b / 9b / 27b)"
    echo "  ./tests/speed-gate.sh --verbose       # full bench output"
    echo
    echo "If this regression is INTENTIONAL (new correctness path, new hardware"
    echo "target that needs the extra cycles, etc.), justify it AND re-baseline"
    echo "from a hipfire-eval report:"
    echo "  hipfire eval --model <model> --battery speed --benchmark --force"
    echo "  git add benchmarks/perf-baselines/"
    echo "  # then re-attempt the commit"
    echo
    echo "Do NOT bypass with --no-verify without a plan to restore perf in the same commit."
    exit 1
fi

echo
echo "=== Both gates passed. Proceeding with commit. ==="
exit 0
