      permuteResult[i] = backwardPermute(firstLane << 2, result[i]);
    }

    return *reinterpret_cast<T*>(permuteResult);
  } else if constexpr (sizeof(T) == 2) {
    union {
      int i;
      T f;
    } tmp;
