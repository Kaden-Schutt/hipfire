    __hip_is_tex_surf_scalar_channel_type<typename T::value_type>::value, const U>::type
__hipMapTo(const T& t) {
  if constexpr (sizeof(typename T::value_type) < sizeof(float)) {
    union {
      U u;
      int4 i4;
    } d = {0};
    d.i4 = __hipMapVector<int, 4>(t);
    return d.u;
  } else {
    union {
      U u;
      T t;
    } d = {0};
    d.t = t;
    return d.u;
  }
}

