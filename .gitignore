*.stackdump

# Cached external research pages (re-fetchable, large, not source)
.research-cache/
research/
.hipfire_kernels.prerebsave/

# Local agent state (gm planning / learning bookkeeping; varies per session)
.gm/git-block-counter.json
.gm/rslearn-counter.json
.gm/turn-state.json
.gm/needs-gm
.gm/lastskill
.gm/no-memorize-this-turn
.gm/learning-state.md
.gm/prd-state.json
.gm/prd.paused.yml
.gm/trajectory-drafts/
.gm/ingest-drafts/

# Scratch research bundles (raw PR diffs, model-conversion test artifacts)
.codeinsight+research/


# kld_reduce.py outputs when run from repo root. Anchored to root: the curated
# benchmark result-*.{json,md} under benchmarks/ must stay tracked (their
# c50-/.kldseq siblings already are).
/result-data.json
/result-table.md
.rocprofv3/

# Generated hipfire-eval run directories. Curated benchmark writeups under
# benchmarks/results remain tracked by explicit filename.
benchmarks/results/eval/
benchmarks/results/eval-smoke/

flake.lock

# Local-only scratchpad of jobs deferred to idle/quiet-box time (per-machine).
NIGHT-WORK.md

# transient / vendored — never commit
node_modules/
.smallcode/
