# Build output (not binaries shipped in releases)
/target
*.o
*.so
*.triattn.bin
*.dll

# Editor
*.swp
*.swo
*~
.DS_Store
.vscode/
.idea/

# Dev / dist
/dev/
/dist/
/man/

# Models (large binaries)
/models/
*.gguf
*.safetensors
*.hfq

# Exception: imatrix .gguf files (1-5 MB calibration sidecars for AWQ) ARE
# tracked — see benchmarks/quality-baselines/refs/. They're tiny and unlock
# `hipfire-quantize --awq` reproduction from a clean clone, including for
# gfx906 (the original RDNA1 target) without an imatrix-collect prereq.
!benchmarks/quality-baselines/refs/*.imatrix.gguf

# JIT-compiled kernel cache
kernels/compiled/
.hipfire_kernels/

# Agent / tool state
.serena/
.remember/
# graphify knowledge graph — mostly regenerable (rebuild with `graphify update .`).
# Ignore the whole tree (graph.json, cache/, dated snapshot dirs, …); keep only
# the durable, commit-worthy state via the un-ignore (!) cherry-picks below.
graphify-out/*
!graphify-out/.graphify_python
!graphify-out/.graphify_root
!graphify-out/.graphify_labels.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/manifest.json
# Machine-specific generated hooks (embed a local interpreter path).
# Each user/agent runs `graphify hook install` on their end.
.githooks/post-commit
.githooks/post-checkout
.codex
.sisyphus/
AGENTS.local.md
CLAUDE.local.md

# Local secrets (lmx api key, etc.) — never commit
.env
.env.*
.env.gemini
docs/superpowers/
.worktrees/
.dflash-reference/
.dflash-ref-hf/
.dflash-ref-hf-4b/
dflash-papers/
kv_research/

# Python
__pycache__/
*.pyc
.venv/

# Logs / temp
*.log
/tmp/


