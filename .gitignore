# Regenerable blobs — large calibration corpora and activation captures
benchmarks/calib/calib-*.txt
benchmarks/references/*_activations/

# Raw benchmark output (logs, f32 tensors) — keep .md/.json summaries only
benchmarks/results/**/*.log
benchmarks/results/**/*.f32

# Investigation source dumps (re-fetchable web/paper archives)
docs/investigations/*/sources/

# Build scratch
/logs/
.scratch/vk-gfx1151/
.scratch/
.opencode/
/.build/

# rocprofv3 / rocpd profiler dumps. The rocpd_info_process table snapshots the
# FULL process environment, so any exported secret (an OPENROUTER_API_KEY leaked
# this way, 2026-06) ends up in the dump — and they're large binary artifacts.
# Never track them anywhere in the tree.
*_results.db
*_results.json
*_results.csv
*.rocpd
*.pftrace

# Harvested corpus index — regenerable from autoresearch/corpus/*.jsonl
# via scripts/harvest_ledgers.py --ingest
autoresearch/db/ar.db

# Redline capture-corpus index — regenerable from redline/corpus/*.jsonl
# via scripts/harvest_redline.py --ingest
redline/db/redline.db

# Local research scratch (agent surveys, microbenches)
.research/

# Code-intelligence index (per-checkout, machine-local)
.codegraph/
# Gate-run artifacts (parent-calibration manifests, gate logs). Regenerate
# with examples/ds4_parent_{inventory,codec}_gate; the durable numbers live
# in commit messages and docs/investigations/.
out/

# DeepSeek V4 reference source is third-party and gitignored at
# .codeinsight+research/; never vendor it into the tracked tree.
crates/hipfire-arch-deepseek4/reference_oracle/model.py
crates/hipfire-arch-deepseek4/reference_oracle/kernel.py
crates/hipfire-arch-deepseek4/reference_oracle/config.json
crates/hipfire-arch-deepseek4/reference_oracle/__pycache__/
